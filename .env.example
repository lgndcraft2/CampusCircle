# ---------------------------------------------------------------------------
# CampusCircle configuration. Copy to .env and fill in. Never commit .env.
# Values below are placeholders only.
# ---------------------------------------------------------------------------

# --- Required -------------------------------------------------------------
ENVIRONMENT=development                 # development | test | production
DATABASE_URL=sqlite:///./campuscircle.db  # production: postgresql+psycopg://user:pass@host:5432/campuscircle
APP_SECRET=change-me-to-40-plus-random-characters  # HMAC key for verification codes
FRONTEND_URL=http://127.0.0.1:5173      # exact browser origin; CORS + Origin checks use it

# --- Development only (rejected in production) ----------------------------
ALLOW_SQLITE=true                       # SQLite is for local runs/tests; deploy on PostgreSQL
DEVELOPMENT_OUTBOX=true                 # writes emails to ./.dev-mail instead of sending them
COOKIE_SECURE=false                     # must be true in production (HTTPS)
LOG_LEVEL=INFO

# --- Brevo transactional email (optional; https://app.brevo.com/settings/keys/api)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=                     # a sender verified in your Brevo account
BREVO_SENDER_NAME=CampusCircle

# --- Groq AI copilot (optional; https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b           # production model per https://console.groq.com/docs/models

# --- B Moni Embedded SANDBOX (optional; https://embedded-docs.bmoni.com)
# Only the sandbox origin https://embedded-dev.bmoni.com is accepted by this app.
BMONI_API_KEY=                          # sandbox x-api-key (shared key is in the B Moni docs, or ask developers@bkey.me)
BMONI_SIGNER_SEED=                      # >=32 random chars; derives each circle's sandbox wallet owner key
BMONI_WEBHOOK_SECRET=                   # secretKey returned by POST /v1/webhooks/config

# Financial ledger mode. Only "simulation" is supported.
FINANCIAL_MODE=simulation
